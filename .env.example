# Local Postgres or a Neon PostgreSQL connection string.
DATABASE_URL=postgresql://pramana:pramana@localhost:5432/pramana
AUTH_MODE=development
# Use AUTH_MODE=credentials for password + secure HttpOnly session auth.
AUTH_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=pramana_session
SESSION_TTL_HOURS=24
APP_BASE_URL=http://localhost:4173

# Set these and change AUTH_MODE=clerk when the Clerk project is ready.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

REDIS_URL=redis://localhost:6379
REDIS_PREFIX=pramana
INFRA_ALLOW_DEGRADED=true
OBJECT_STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pramana-local
# Generation provider: mock | gemini | nim
MODEL_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# NVIDIA NIM: hosted (default) or a self-hosted NIM base URL.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
NIM_MODEL=meta/llama-3.3-70b-instruct
# Embedding provider: mock | service (the services/retrieval Python service).
EMBEDDING_PROVIDER=mock
RETRIEVAL_SERVICE_URL=http://localhost:8003
# Minimum cosine similarity for a knowledge chunk to be returned as a citation.
KNOWLEDGE_SIMILARITY_THRESHOLD=0.2
INGESTION_SERVICE_URL=http://localhost:8001
SOLVER_SERVICE_URL=http://localhost:8002
LOCAL_UPLOAD_DIR=./data/uploads
# Grace window before an ETA becomes amber/red relative to required-on-site time.
SHIPMENT_STATUS_BUFFER_HOURS=72
RISK_POLL_MODE=synthetic
RISK_PROBABILITY_THRESHOLD=0.5
RISK_DELAY_HOURS_THRESHOLD=8
# RISK_PROCUREMENT_URL=https://signals.example/procurement
# RISK_LEAD_TIME_URL=https://signals.example/lead-time
# RISK_WORKFORCE_URL=https://signals.example/workforce
# RISK_WEATHER_URL=https://signals.example/weather
