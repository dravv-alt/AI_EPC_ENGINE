# Local development values. Docker Compose is a production-oriented manifest
# and requires the separate deployment values at the end of this file; it will
# refuse to start with development auth, mock providers, or default secrets.
# Local Postgres or a Neon PostgreSQL connection string.
DATABASE_URL=postgresql://pramana:pramana@localhost:5432/pramana
AUTH_MODE=development
# Use AUTH_MODE=credentials for password + secure HttpOnly session auth.
AUTH_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=pramana_session
SESSION_TTL_HOURS=24
APP_BASE_URL=http://localhost:3000

# Set these and change AUTH_MODE=clerk when the Clerk project is ready.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/pending-access

REDIS_URL=redis://localhost:6379
REDIS_PREFIX=pramana
INFRA_ALLOW_DEGRADED=true
OBJECT_STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pramana-local
# Generation provider: ollama | mock | gemini | nim | groq | cerebras.
# The copilot can use an independent generation provider without changing RAG.
MODEL_PROVIDER=ollama
COPILOT_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Gemma 4 E2B: `ollama pull gemma4:e2b` (approximately 7.2 GB).
OLLAMA_MODEL=gemma4:e2b
# This repository's pgvector columns are fixed at 768 dimensions.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
# Bound all local inference so a slow model cannot exhaust server/browser work.
MODEL_TIMEOUT_MS=45000
# Legacy Ollama-only override. Leave unset to use MODEL_TIMEOUT_MS everywhere.
# OLLAMA_TIMEOUT_MS=45000
MODEL_PROMPT_MAX_CHARS=60000
MODEL_OUTPUT_MAX_TOKENS=512
MODEL_CONTEXT_TOKENS=8192
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
# NVIDIA NIM: hosted (default) or a self-hosted NIM base URL.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
NIM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_API_KEY=
# Dedicated preview deployments may expose an organization-specific model id.
CEREBRAS_MODEL=gemma-4-31b
# Embedding provider: ollama | gemini | mock | service | pinecone.
# This is independent from MODEL_PROVIDER so a provider change never mixes
# incompatible vector spaces. Use `gemini` here only when explicitly desired.
EMBEDDING_PROVIDER=ollama
PINECONE_API_KEY=
PINECONE_BASE_URL=https://api.pinecone.io
PINECONE_API_VERSION=2026-04
PINECONE_EMBEDDING_MODEL=llama-text-embed-v2
# Must remain 768 unless the pgvector schema is migrated deliberately.
PINECONE_EMBEDDING_DIMENSIONS=768
RETRIEVAL_SERVICE_URL=http://localhost:8003
KNOWLEDGE_RERANK_THRESHOLD=0.5
# Minimum cosine similarity for a knowledge chunk to be returned as a citation.
KNOWLEDGE_SIMILARITY_THRESHOLD=0.5
INGESTION_SERVICE_URL=http://localhost:8001
SOLVER_SERVICE_URL=http://localhost:8002
LOCAL_UPLOAD_DIR=./data/uploads
# Grace window before an ETA becomes amber/red relative to required-on-site time.
SHIPMENT_STATUS_BUFFER_HOURS=72
RISK_POLL_MODE=synthetic
WEATHER_MODE=open-meteo
RISK_PROBABILITY_THRESHOLD=0.5
RISK_DELAY_HOURS_THRESHOLD=8
# RISK_PROCUREMENT_URL=https://signals.example/procurement
# RISK_LEAD_TIME_URL=https://signals.example/lead-time
# RISK_WORKFORCE_URL=https://signals.example/workforce
# RISK_WEATHER_URL=https://signals.example/weather

# Named, overridable accuracy/latency targets (TRD NFR table; PRD success metrics).
# Golden-set evaluation targets/config only -- nothing gates on these beyond the solver timeout.
COMPLIANCE_DEVIATION_ACCURACY_TARGET=0.95
RISK_LEAD_TIME_TARGET_HOURS=48
RFI_MATCH_ACCURACY_TARGET=0.85
HIGH_SEVERITY_PRECISION_TARGET=0.9
PACK_PREP_TIME_REDUCTION_TARGET=0.6
# CP-SAT solver microservice request timeout/retry cap (Rules.md line 33: default 90s, configurable).
SOLVER_TIMEOUT_MS=90000
SOLVER_MAX_ATTEMPTS=3

# Per-category rate-limit budgets (Rules.md line 87). AI_RATE_LIMIT already covers
# AI/compliance/knowledge routes; these cover the remaining named categories.
AUTH_RATE_LIMIT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
SCHEDULE_RATE_LIMIT=30
SCHEDULE_RATE_LIMIT_WINDOW_SECONDS=60
EXPORT_RATE_LIMIT=10
EXPORT_RATE_LIMIT_WINDOW_SECONDS=60
