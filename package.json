    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.30.1",
    "redis-memory-server": "^0.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
