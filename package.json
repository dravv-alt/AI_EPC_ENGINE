{
  "name": "pramana-cx",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "system:run": "tsx --env-file=.env scripts/run-system.ts",
    "system:start": "npm run db:migrate && npm run build && npm run system:run",
    "verify:audit": "tsx --env-file=.env scripts/verify-audit-chain.ts",
    "verify:phase0": "tsx --env-file=.env scripts/verify-phase0.ts",
    "verify:credentials-http": "tsx --env-file=.env scripts/verify-credentials-http.ts",
    "verify:schedule-http": "tsx --env-file=.env scripts/verify-schedule-http.ts",
    "verify:cx-http": "tsx --env-file=.env scripts/verify-cx-http.ts",
    "verify:compliance-http": "tsx --env-file=.env scripts/verify-compliance-http.ts",
    "verify:risk-http": "tsx --env-file=.env scripts/verify-risk-http.ts",
    "verify:evidence-turnover-http": "tsx --env-file=.env scripts/verify-evidence-turnover-http.ts",
    "verify:all": "tsx --env-file=.env scripts/verify-all.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/s3-request-presigner": "^3.1089.0",
