    "@fontsource/hanken-grotesk": "^5.1.1",
    "@fontsource/ibm-plex-serif": "^5.1.1",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@turf/along": "^7.3.5",
    "@turf/bearing": "^7.3.5",
    "@turf/bezier-spline": "^7.3.5",
    "@turf/distance": "^7.3.5",
    "@turf/great-circle": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/length": "^7.3.5",
    "@turf/turf": "^7.3.5",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.7",
    "csv-parse": "^7.0.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "otpauth": "^9.5.1",
    "postgres": "^3.4.7",
